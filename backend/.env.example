PORT=3000
FRONTEND_URL=http://localhost:5173

# Option 1 — single connection string (takes priority over individual DB_* vars).
# Required for Neon PostgreSQL on Railway. Format:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Option 2 — individual connection variables (used when DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=job_portal

JWT_SECRET=change-me

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM="Job Portal <no-reply@example.com>"

AI_PROVIDER=
AI_API_KEY=
